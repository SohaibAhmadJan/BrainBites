[
    {
        "id": "tab_content_automation",
        "type": "tab",
        "label": "AI Content & Multi-Platform Automation",
        "disabled": false,
        "info": "Automated multi-agent content generation with multi-account rotation and YouTube/Facebook/TikTok publishing."
    },
    {
        "id": "inject_scheduler",
        "type": "inject",
        "z": "tab_content_automation",
        "name": "Trigger Schedule (Every 6h)",
        "props": [
            {
                "property": "payload",
                "type": "str",
                "value": "Generate Content"
            }
        ],
        "repeat": "21600",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "payloadType": "str",
        "x": 160,
        "y": 140,
        "wires": [
            ["fn_account_rotator"]
        ]
    },
    {
        "id": "fn_account_rotator",
        "type": "function",
        "z": "tab_content_automation",
        "name": "Account & Key Rotator",
        "func": "// Initialize multi-account pool if not exists\nif (!flow.get(\"accountPool\")) {\n    flow.set(\"accountPool\", [\n        { email: \"account1@gmail.com\", apiKey: \"AIzaSy_YOUR_KEY_1_HERE\" },\n        { email: \"account2@gmail.com\", apiKey: \"AIzaSy_YOUR_KEY_2_HERE\" },\n        { email: \"account3@gmail.com\", apiKey: \"AIzaSy_YOUR_KEY_3_HERE\" }\n    ]);\n    flow.set(\"currentAccountIndex\", 0);\n}\n\nlet pool = flow.get(\"accountPool\");\nlet index = flow.get(\"currentAccountIndex\");\n\nlet currentAccount = pool[index];\nmsg.currentAccount = currentAccount;\nmsg.retryCount = msg.retryCount || 0;\n\nnode.warn(`Using account: ${currentAccount.email} (Index: ${index})`);\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 140,
        "wires": [
            ["http_gemini_ideation"]
        ]
    },
    {
        "id": "http_gemini_ideation",
        "type": "http-request",
        "z": "tab_content_automation",
        "name": "AI Agent 1: Ideation (Gemini)",
        "method": "POST",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key={{{currentAccount.apiKey}}}",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "headers": [
            {
                "key": "Content-Type",
                "value": "application/json"
            }
        ],
        "x": 710,
        "y": 140,
        "wires": [
            ["fn_parse_ideation"]
        ]
    },
    {
        "id": "fn_parse_ideation",
        "type": "function",
        "z": "tab_content_automation",
        "name": "Parse & Prepare Script Agent",
        "func": "let response = msg.payload;\nif (response && response.candidates && response.candidates[0]) {\n    let text = response.candidates[0].content.parts[0].text;\n    msg.payload = {\n        topic: text,\n        prompt: `Write an engaging 60-second video script and social media caption for YouTube Shorts, Facebook Reels, and TikTok based on this topic: ${text}`\n    };\n    return msg;\n}\nnode.error(\"Failed to generate ideation\", msg);\nreturn null;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 240,
        "y": 240,
        "wires": [
            ["http_gemini_script"]
        ]
    },
    {
        "id": "http_gemini_script",
        "type": "http-request",
        "z": "tab_content_automation",
        "name": "AI Agent 2: Script Writer",
        "method": "POST",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key={{{currentAccount.apiKey}}}",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "headers": [
            {
                "key": "Content-Type",
                "value": "application/json"
            }
        ],
        "x": 580,
        "y": 240,
        "wires": [
            ["fn_format_publishing"]
        ]
    },
    {
        "id": "fn_format_publishing",
        "type": "function",
        "z": "tab_content_automation",
        "name": "Format for Social Media",
        "func": "let response = msg.payload;\nif (response && response.candidates && response.candidates[0]) {\n    let scriptText = response.candidates[0].content.parts[0].text;\n    msg.content = {\n        script: scriptText,\n        title: \"Mind Blowing Fact of the Day! 🤯 #shorts\",\n        platforms: [\"youtube\", \"facebook\", \"tiktok\"]\n    };\n    return [msg, msg, msg]; // Split into 3 paths for 3 platforms\n}\nreturn null;",
        "outputs": 3,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 860,
        "y": 240,
        "wires": [
            ["http_publish_youtube"],
            ["http_publish_facebook"],
            ["http_publish_tiktok"]
        ]
    },
    {
        "id": "http_publish_youtube",
        "type": "http-request",
        "z": "tab_content_automation",
        "name": "Publish to YouTube Shorts",
        "method": "POST",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "https://www.googleapis.com/youtube/v3/videos?part=snippet,status",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "bearer",
        "x": 300,
        "y": 380,
        "wires": [
            ["debug_success"]
        ]
    },
    {
        "id": "http_publish_facebook",
        "type": "http-request",
        "z": "tab_content_automation",
        "name": "Publish to Facebook Reels",
        "method": "POST",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "https://graph.facebook.com/v18.0/me/feed",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "bearer",
        "x": 590,
        "y": 380,
        "wires": [
            ["debug_success"]
        ]
    },
    {
        "id": "http_publish_tiktok",
        "type": "http-request",
        "z": "tab_content_automation",
        "name": "Publish to TikTok",
        "method": "POST",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "https://open.tiktokapis.com/v2/post/publish/video/init/",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "bearer",
        "x": 850,
        "y": 380,
        "wires": [
            ["debug_success"]
        ]
    },
    {
        "id": "debug_success",
        "type": "debug",
        "z": "tab_content_automation",
        "name": "Publish Result",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
        "x": 580,
        "y": 480,
        "wires": []
    },
    {
        "id": "catch_errors",
        "type": "catch",
        "z": "tab_content_automation",
        "name": "Quota / Rate Limit Catcher",
        "scope": [
            "http_gemini_ideation",
            "http_gemini_script"
        ],
        "finalize": "",
        "x": 200,
        "y": 40,
        "wires": [
            ["fn_rotate_on_error"]
        ]
    },
    {
        "id": "fn_rotate_on_error",
        "type": "function",
        "z": "tab_content_automation",
        "name": "Rotate Account & Retry",
        "func": "let err = msg.error;\nlet pool = flow.get(\"accountPool\");\nlet index = flow.get(\"currentAccountIndex\");\n\nnode.warn(`Quota / Error encountered on account ${pool[index].email}: ${err.message}. Rotating account...`);\n\n// Rotate to next account in round-robin fashion\nindex = (index + 1) % pool.length;\nflow.set(\"currentAccountIndex\", index);\n\nmsg.retryCount = (msg.retryCount || 0) + 1;\n\nif (msg.retryCount <= pool.length) {\n    // Retry with new account\n    return [msg];\n} else {\n    node.error(\"All accounts in pool exhausted quota!\");\n    return null;\n}",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 480,
        "y": 40,
        "wires": [
            ["fn_account_rotator"]
        ]
    }
]
