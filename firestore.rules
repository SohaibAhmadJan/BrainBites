rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isAuthenticated() { return request.auth != null; }
    function isOwner(uid) { return request.auth.uid == uid; }

    function getUserData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isActiveUser(uid) {
      return !exists(/databases/$(database)/documents/users/$(uid)) ||
             getUserData(uid).account.status == 'ACTIVE';
    }

    function getAdmin() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
             getAdmin().isActive == true;
    }

    function hasPermission(perm) {
      return isAdmin() && (getAdmin().role == 'SUPER_ADMIN' || perm in getAdmin().permissions);
    }

    // --- GLOBAL CONTENT (API-ONLY) ---
    // Content is READ-ONLY for all authenticated clients.
    // Mutations are handled by the Trusted Backend (Admin SDK).
    match /facts/{id} { allow read: if true; allow write: if false; }
    match /quizzes/{id} { allow read: if true; allow write: if false; }
    match /categories/{id} { allow read: if true; allow write: if false; }
    match /collections/{id} { allow read: if true; allow write: if false; }
    match /achievements/{id} { allow read: if true; allow write: if false; }
    match /app_config/global { allow read: if true; allow write: if false; }
    match /notifications/{id} { allow read: if true; allow write: if false; }

    // --- USER DATA (CLIENT-DRIVEN) ---
    match /users/{userId} {
      allow read: if isOwner(userId) || hasPermission('users.view');

      // Allow initial document creation for new users
      allow create: if isOwner(userId) && request.resource.data.account.status == 'ACTIVE';

      // Update rules:
      // 1. User cannot change account.uid or account.status.
      // 2. User cannot skip stats (throttling).
      allow update: if (isOwner(userId) && isActiveUser(userId) &&
                       request.resource.data.account == resource.data.account &&
                       request.resource.data.stats.streakCount <= resource.data.stats.streakCount + 1 &&
                       request.resource.data.stats.factsReadCount <= resource.data.stats.factsReadCount + 50)
                    || (hasPermission('users.edit'));

      // Subcollections
      match /favorites/{id} { allow read, write: if isOwner(userId) && isActiveUser(userId); }
      match /history/{id} { allow read, write: if isOwner(userId) && isActiveUser(userId); }
      match /achievements/{id} {
        allow read: if isOwner(userId) || hasPermission('users.view');
        allow write: if false;
      }
      match /collectionProgress/{id} { allow read, write: if isOwner(userId) && isActiveUser(userId); }
      match /quizResults/{id} {
        allow read: if isOwner(userId) || hasPermission('users.view');
        allow create: if isOwner(userId) && isActiveUser(userId);
      }
      match /notifications/{id} { allow read, update: if isOwner(userId) && isActiveUser(userId); }
      match /devices/{id} { allow read, write: if isOwner(userId) && isActiveUser(userId); }
    }

    // --- SYSTEM & TELEMETRY ---
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /audit_logs/{logId} {
      allow read: if hasPermission('audit.view');
      allow write: if false;
    }

    match /analytics_events/{eventId} {
      allow create: if isAuthenticated() &&
                    request.resource.data.uid == request.auth.uid &&
                    request.resource.data.timestamp == request.time;
      allow read: if hasPermission('analytics.view');
    }
  }
}
